---
// ~8 saniyelik flat-design SVG/CSS çizgi film introsu (6 sahne):
// uçak inişi → VIP transfer → fil koruma alanı → plaj/longtail → gün batımında yat → marka.
// Bir kez oynar, sonra kaybolup mevcut HeroSlider + başlık + CTA'ları ortaya çıkarır.
// prefers-reduced-motion açıksa hiç oynamaz; JS olmadan da CSS ile kendini gizler.
// Sahne pencereleri: s1 0-1400, s2 1250-2650, s3 2500-3900, s4 3750-5150, s5 5000-6350, s6 6100+.
// Sahne içi hareket animasyonları (uçak, van, fil, tekneler) kendi sahnesinin delay'iyle senkron olmalı.
---

<div id="hero-intro" class="hero-intro" aria-hidden="true">
  <svg class="intro-svg" viewBox="0 0 1200 675" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Phuket tatilinin animasyonlu tanıtımı">
    <defs>
      <linearGradient id="hi-dawn" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fde68a" /><stop offset="45%" stop-color="#fca5a5" /><stop offset="100%" stop-color="#c7d2fe" />
      </linearGradient>
      <linearGradient id="hi-day" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#7dd3fc" /><stop offset="100%" stop-color="#e0f2fe" />
      </linearGradient>
      <linearGradient id="hi-sea" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#38bdf8" /><stop offset="48%" stop-color="#22d3ee" /><stop offset="100%" stop-color="#0e7490" />
      </linearGradient>
      <linearGradient id="hi-gold" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fbbf24" /><stop offset="55%" stop-color="#f97316" /><stop offset="100%" stop-color="#7c2d12" />
      </linearGradient>
      <radialGradient id="hi-brand" cx="50%" cy="42%" r="75%">
        <stop offset="0%" stop-color="#1e293b" /><stop offset="100%" stop-color="#0f172a" />
      </radialGradient>
      <linearGradient id="hi-sand" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fde68a" /><stop offset="100%" stop-color="#fcd34d" />
      </linearGradient>
      <linearGradient id="hi-jungle" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fef9c3" /><stop offset="60%" stop-color="#d9f99d" /><stop offset="100%" stop-color="#bbf7d0" />
      </linearGradient>
    </defs>

    <!-- ============ SCENE 1 : HAVAALANI İNİŞİ ============ -->
    <g class="scene s1">
      <rect width="1200" height="675" fill="url(#hi-dawn)" />
      <g class="sun"><circle cx="960" cy="150" r="52" fill="#fff7ed" opacity="0.95" />
        <g class="rays" stroke="#fff7ed" stroke-width="7" stroke-linecap="round" opacity="0.7">
          <line x1="960" y1="60" x2="960" y2="30" /><line x1="960" y1="240" x2="960" y2="270" />
          <line x1="870" y1="150" x2="840" y2="150" /><line x1="1050" y1="150" x2="1080" y2="150" />
          <line x1="897" y1="87" x2="876" y2="66" /><line x1="1023" y1="213" x2="1044" y2="234" />
          <line x1="897" y1="213" x2="876" y2="234" /><line x1="1023" y1="87" x2="1044" y2="66" />
        </g></g>
      <g class="cloud c1" fill="#ffffff" opacity="0.85"><ellipse cx="230" cy="140" rx="60" ry="30" /><ellipse cx="285" cy="150" rx="45" ry="24" /><ellipse cx="185" cy="152" rx="40" ry="22" /></g>
      <g class="cloud c2" fill="#ffffff" opacity="0.7"><ellipse cx="620" cy="90" rx="50" ry="24" /><ellipse cx="665" cy="98" rx="38" ry="20" /></g>
      <path d="M0 470 Q200 400 420 460 T820 450 T1200 470 L1200 675 L0 675 Z" fill="#a7f3d0" opacity="0.55" />
      <!-- terminal + kule -->
      <rect x="770" y="360" width="330" height="120" rx="10" fill="#e2e8f0" />
      <rect x="770" y="360" width="330" height="26" rx="10" fill="#0f172a" opacity="0.12" />
      <g fill="#38bdf8" opacity="0.75"><rect x="800" y="400" width="40" height="46" rx="4" /><rect x="860" y="400" width="40" height="46" rx="4" /><rect x="920" y="400" width="40" height="46" rx="4" /><rect x="980" y="400" width="40" height="46" rx="4" /><rect x="1040" y="400" width="40" height="46" rx="4" /></g>
      <rect x="700" y="300" width="26" height="180" fill="#cbd5e1" /><rect x="676" y="278" width="74" height="40" rx="8" fill="#94a3b8" /><rect x="686" y="286" width="54" height="20" rx="4" fill="#38bdf8" opacity="0.8" />
      <!-- pist -->
      <path d="M120 675 L470 480 L760 480 L1200 675 Z" fill="#334155" />
      <g class="runway" stroke="#f8fafc" stroke-width="7" stroke-dasharray="34 30" opacity="0.85"><line x1="430" y1="500" x2="900" y2="640" /></g>
      <!-- uçak -->
      <g class="plane">
        <g transform="translate(0,0)">
          <path d="M0 20 L150 20 L188 6 L150 -8 L0 -8 Z" fill="#f8fafc" />
          <path d="M60 -6 L110 -60 L132 -60 L104 -6 Z" fill="#e2e8f0" />
          <path d="M60 18 L104 66 L126 66 L96 18 Z" fill="#cbd5e1" />
          <path d="M150 -8 L188 6 L150 20 Z" fill="#d97706" />
          <circle cx="42" cy="6" r="5" fill="#38bdf8" /><circle cx="66" cy="6" r="5" fill="#38bdf8" /><circle cx="90" cy="6" r="5" fill="#38bdf8" />
        </g>
      </g>
    </g>

    <!-- ============ SCENE 2 : VIP TRANSFER ============ -->
    <g class="scene s2">
      <rect width="1200" height="675" fill="url(#hi-day)" />
      <circle cx="200" cy="120" r="46" fill="#fef08a" />
      <g class="cloud c2" fill="#ffffff" opacity="0.9"><ellipse cx="820" cy="110" rx="62" ry="30" /><ellipse cx="875" cy="120" rx="44" ry="24" /></g>
      <!-- şehir silüeti -->
      <g fill="#bae6fd"><rect x="60" y="300" width="90" height="180" rx="6" /><rect x="170" y="250" width="80" height="230" rx="6" /><rect x="930" y="280" width="100" height="200" rx="6" /><rect x="1050" y="320" width="80" height="160" rx="6" /></g>
      <g fill="#7dd3fc" opacity="0.7"><rect x="270" y="330" width="70" height="150" rx="6" /><rect x="850" y="330" width="60" height="150" rx="6" /></g>
      <!-- palmiye grubu (kayan) -->
      <g class="palms">
        <g class="palmset">
          <g transform="translate(420,300)"><rect x="-6" y="0" width="12" height="180" rx="6" fill="#92400e" /><g fill="#16a34a"><path d="M0 6 C-40 -18 -78 -12 -96 12 C-60 2 -30 10 0 22 Z" /><path d="M0 6 C40 -18 78 -12 96 12 C60 2 30 10 0 22 Z" /><path d="M0 2 C-16 -34 -46 -50 -74 -46 C-40 -30 -18 -14 0 16 Z" /><path d="M0 2 C16 -34 46 -50 74 -46 C40 -30 18 -14 0 16 Z" /></g></g>
          <g transform="translate(760,320) scale(0.85)"><rect x="-6" y="0" width="12" height="170" rx="6" fill="#92400e" /><g fill="#15803d"><path d="M0 6 C-40 -18 -78 -12 -96 12 C-60 2 -30 10 0 22 Z" /><path d="M0 6 C40 -18 78 -12 96 12 C60 2 30 10 0 22 Z" /><path d="M0 2 C-16 -34 -46 -50 -74 -46 C-40 -30 -18 -14 0 16 Z" /><path d="M0 2 C16 -34 46 -50 74 -46 C40 -30 18 -14 0 16 Z" /></g></g>
        </g>
      </g>
      <!-- yol -->
      <rect x="0" y="480" width="1200" height="195" fill="#475569" />
      <rect x="0" y="480" width="1200" height="14" fill="#334155" />
      <g class="lane" stroke="#f8fafc" stroke-width="8" stroke-dasharray="46 40"><line x1="0" y1="576" x2="1240" y2="576" /></g>
      <!-- VIP araç -->
      <g class="van">
        <g transform="translate(0,0)">
          <rect x="0" y="0" width="230" height="96" rx="22" fill="#0f172a" />
          <path d="M150 6 L214 30 Q228 36 228 52 L228 74 Q228 90 212 90 L150 90 Z" fill="#0f172a" />
          <rect x="26" y="16" width="52" height="40" rx="8" fill="#7dd3fc" /><rect x="88" y="16" width="52" height="40" rx="8" fill="#7dd3fc" /><path d="M156 18 L200 38 L200 56 L156 56 Z" fill="#7dd3fc" />
          <rect x="0" y="66" width="230" height="10" fill="#d97706" />
          <text x="40" y="88" font-family="DM Sans, sans-serif" font-size="20" font-weight="700" fill="#f8fafc" letter-spacing="2">VIP</text>
          <g class="wheel"><circle cx="56" cy="98" r="22" fill="#1e293b" /><circle cx="56" cy="98" r="9" fill="#94a3b8" /></g>
          <g class="wheel"><circle cx="184" cy="98" r="22" fill="#1e293b" /><circle cx="184" cy="98" r="9" fill="#94a3b8" /></g>
        </g>
      </g>
    </g>

    <!-- ============ SCENE 3 : FİL KORUMA ALANI ============ -->
    <g class="scene s3">
      <rect width="1200" height="675" fill="url(#hi-jungle)" />
      <!-- yağmur ormanı tacı -->
      <g fill="#166534"><circle cx="80" cy="40" r="90" /><circle cx="240" cy="20" r="100" /><circle cx="420" cy="50" r="95" /><circle cx="600" cy="15" r="105" /><circle cx="790" cy="45" r="95" /><circle cx="960" cy="10" r="100" /><circle cx="1130" cy="50" r="90" /></g>
      <g fill="#15803d" opacity="0.9"><circle cx="160" cy="95" r="70" /><circle cx="330" cy="110" r="65" /><circle cx="520" cy="100" r="72" /><circle cx="700" cy="115" r="66" /><circle cx="880" cy="100" r="72" /><circle cx="1060" cy="112" r="66" /></g>
      <circle cx="980" cy="200" r="60" fill="#fef9c3" opacity="0.55" />
      <!-- tepeler ve çayır -->
      <path d="M0 430 Q200 340 420 420 T840 410 T1200 430 L1200 675 L0 675 Z" fill="#86efac" />
      <path d="M0 520 Q300 490 640 510 T1200 505 L1200 675 L0 675 Z" fill="#4ade80" />
      <!-- kelebek (konum CSS keyframe'lerinde) -->
      <g class="butterfly">
        <g class="wings"><ellipse cx="-10" cy="0" rx="12" ry="8" fill="#f472b6" /><ellipse cx="10" cy="0" rx="12" ry="8" fill="#fb7185" /></g>
        <rect x="-1.5" y="-7" width="3" height="14" rx="1.5" fill="#0f172a" />
      </g>
      <!-- yavru fil -->
      <g class="baby-bob">
        <g transform="translate(250,470) scale(0.45)">
          <rect x="30" y="150" width="30" height="66" rx="14" fill="#64748b" /><rect x="110" y="150" width="30" height="66" rx="14" fill="#64748b" />
          <ellipse cx="100" cy="110" rx="85" ry="60" fill="#94a3b8" />
          <circle cx="185" cy="90" r="46" fill="#94a3b8" />
          <ellipse cx="172" cy="88" rx="28" ry="34" fill="#64748b" />
          <circle cx="200" cy="78" r="5" fill="#0f172a" />
          <path d="M218 110 q22 20 14 52" stroke="#94a3b8" stroke-width="20" fill="none" stroke-linecap="round" />
        </g>
      </g>
      <!-- rehber: muz ikram ediyor (tur: besleme deneyimi) -->
      <g class="keeper">
        <g transform="translate(960,410)">
        <g transform="scale(-1,1)">
          <rect x="10" y="120" width="16" height="56" rx="8" fill="#78350f" /><rect x="38" y="120" width="16" height="56" rx="8" fill="#78350f" />
          <rect x="4" y="96" width="56" height="36" rx="10" fill="#334155" />
          <rect x="6" y="40" width="52" height="62" rx="14" fill="#d97706" />
          <circle cx="32" cy="22" r="18" fill="#fcd9b8" />
          <path d="M2 16 Q32 -14 62 16 Z" fill="#f59e0b" /><rect x="-2" y="14" width="68" height="7" rx="3.5" fill="#d97706" />
          <g class="keeper-arm">
            <rect x="52" y="52" width="64" height="14" rx="7" fill="#d97706" />
            <circle cx="120" cy="59" r="9" fill="#fcd9b8" />
            <path d="M118 44 q22 -8 34 10 q-20 -6 -34 -4 Z" fill="#facc15" stroke="#ca8a04" stroke-width="1.5" />
            <path d="M120 56 q22 -4 30 14 q-18 -8 -30 -8 Z" fill="#fde047" stroke="#ca8a04" stroke-width="1.5" />
          </g>
        </g>
        </g>
      </g>
      <!-- fil: eyersiz, etik koruma alanı -->
      <g class="elephant-walk">
        <g class="elephant-bob">
          <g transform="translate(620,320)">
            <path d="M8 96 q-22 10 -18 44" stroke="#64748b" stroke-width="8" fill="none" stroke-linecap="round" />
            <rect x="30" y="140" width="34" height="76" rx="16" fill="#64748b" /><rect x="120" y="140" width="34" height="76" rx="16" fill="#64748b" />
            <ellipse cx="105" cy="105" rx="100" ry="72" fill="#94a3b8" />
            <rect x="55" y="150" width="34" height="70" rx="16" fill="#94a3b8" /><rect x="145" y="150" width="34" height="70" rx="16" fill="#94a3b8" />
            <g fill="#e2e8f0"><circle cx="64" cy="214" r="4" /><circle cx="76" cy="216" r="4" /><circle cx="154" cy="214" r="4" /><circle cx="166" cy="216" r="4" /></g>
            <circle cx="205" cy="90" r="56" fill="#94a3b8" />
            <g class="elephant-ear"><ellipse cx="192" cy="86" rx="36" ry="44" fill="#64748b" /></g>
            <circle cx="222" cy="76" r="5.5" fill="#0f172a" /><circle cx="224" cy="74" r="2" fill="#f8fafc" />
            <path d="M222 122 q16 14 12 30" stroke="#f8fafc" stroke-width="9" fill="none" stroke-linecap="round" />
            <g class="elephant-trunk">
              <path d="M240 108 q34 18 30 66 q-3 40 -34 44 q-24 3 -26 -16" stroke="#94a3b8" stroke-width="26" fill="none" stroke-linecap="round" />
            </g>
          </g>
        </g>
      </g>
      <!-- ön plan otları -->
      <g stroke="#16a34a" stroke-width="5" stroke-linecap="round" fill="none" opacity="0.8">
        <path d="M120 620 q6 -22 2 -34" /><path d="M132 620 q2 -24 10 -32" />
        <path d="M980 640 q6 -22 2 -34" /><path d="M992 640 q2 -24 10 -32" />
        <path d="M520 655 q6 -22 2 -34" /><path d="M532 655 q2 -24 10 -32" />
      </g>
    </g>

    <!-- ============ SCENE 4 : PLAJ & LONGTAIL ============ -->
    <g class="scene s4">
      <rect width="1200" height="675" fill="url(#hi-sea)" />
      <circle cx="1000" cy="120" r="48" fill="#fff7ed" opacity="0.95" />
      <!-- kireçtaşı adaları -->
      <path d="M120 300 L180 190 L230 300 Z" fill="#155e75" opacity="0.85" /><path d="M195 300 L250 220 L300 300 Z" fill="#0e7490" opacity="0.8" />
      <path d="M820 300 L880 200 L945 300 Z" fill="#155e75" opacity="0.8" />
      <g fill="#0e7490" opacity="0.5"><ellipse cx="220" cy="302" rx="120" ry="12" /><ellipse cx="880" cy="302" rx="90" ry="10" /></g>
      <!-- dalga çizgileri -->
      <g class="waves" stroke="#e0f7ff" stroke-width="5" stroke-linecap="round" opacity="0.55" fill="none">
        <path d="M-100 380 q40 -14 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0" />
        <path d="M-100 430 q40 -14 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0" />
      </g>
      <!-- kumsal -->
      <path d="M0 520 Q300 486 640 512 T1200 500 L1200 675 L0 675 Z" fill="url(#hi-sand)" />
      <!-- eğik palmiye -->
      <g transform="translate(150,520)"><path d="M0 0 C-10 -80 6 -140 40 -186" stroke="#92400e" stroke-width="16" fill="none" stroke-linecap="round" /><g fill="#16a34a" transform="translate(40,-186)"><path d="M0 0 C-46 -18 -84 -4 -96 22 C-58 6 -26 8 0 14 Z" /><path d="M0 0 C40 -22 80 -14 96 10 C58 -2 26 4 0 14 Z" /><path d="M0 -4 C-14 -40 -44 -58 -74 -56 C-40 -36 -16 -18 0 8 Z" /><path d="M0 -4 C18 -40 50 -56 78 -50 C44 -32 18 -16 0 8 Z" /></g></g>
      <!-- plaj şemsiyesi -->
      <g transform="translate(1010,540)"><rect x="-4" y="-70" width="8" height="90" fill="#92400e" /><path d="M-64 -70 Q0 -118 64 -70 Z" fill="#d97706" /><path d="M-64 -70 Q-32 -92 0 -70 Q32 -92 64 -70 Z" fill="#f59e0b" /></g>
      <!-- longtail tekne -->
      <g class="longtail-sail">
        <g class="longtail-bob">
          <path d="M0 40 L250 40 L210 78 L34 78 Z" fill="#7c2d12" />
          <path d="M0 40 L250 40 L246 50 L4 50 Z" fill="#f59e0b" />
          <path d="M250 40 L330 22 L250 30 Z" fill="#92400e" />
          <g stroke="#dc2626" stroke-width="5" stroke-linecap="round"><line x1="300" y1="28" x2="316" y2="60" /></g>
          <g stroke="#2563eb" stroke-width="5" stroke-linecap="round"><line x1="288" y1="30" x2="300" y2="62" /></g>
          <rect x="70" y="6" width="110" height="34" rx="8" fill="#fde68a" /><rect x="70" y="6" width="110" height="10" rx="5" fill="#d97706" />
          <circle cx="120" cy="-6" r="12" fill="#fca5a5" /><path d="M104 -12 Q120 -30 136 -12 Z" fill="#f8fafc" />
        </g>
      </g>
    </g>

    <!-- ============ SCENE 5 : YAT & ADA TURU ============ -->
    <g class="scene s5">
      <rect width="1200" height="675" fill="url(#hi-gold)" />
      <circle cx="600" cy="230" r="80" fill="#fff7ed" opacity="0.9" />
      <g class="cloud c1" fill="#fde68a" opacity="0.5"><ellipse cx="260" cy="150" rx="70" ry="26" /><ellipse cx="320" cy="158" rx="48" ry="20" /></g>
      <!-- Phi Phi silüeti -->
      <path d="M120 430 L210 250 L300 430 Z" fill="#7c2d12" opacity="0.9" /><path d="M250 430 L330 300 L410 430 Z" fill="#9a3412" opacity="0.85" />
      <path d="M820 430 L920 260 L1020 430 Z" fill="#7c2d12" opacity="0.9" /><path d="M960 430 L1030 320 L1110 430 Z" fill="#9a3412" opacity="0.85" />
      <rect x="0" y="428" width="1200" height="247" fill="#0e7490" opacity="0.85" />
      <g class="waves" stroke="#fef3c7" stroke-width="4" stroke-linecap="round" opacity="0.4" fill="none">
        <path d="M-100 480 q40 -12 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0" />
        <path d="M-100 540 q40 -12 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0" />
      </g>
      <!-- kuşlar -->
      <g class="birds" stroke="#7c2d12" stroke-width="4" fill="none" stroke-linecap="round" opacity="0.7">
        <path d="M700 150 q14 -12 28 0 q14 -12 28 0" /><path d="M780 190 q10 -9 20 0 q10 -9 20 0" />
      </g>
      <!-- sürat teknesi + iz -->
      <g class="speedboat">
        <g transform="translate(0,0)">
          <path d="M-160 62 Q-60 40 40 60 L20 78 L-150 78 Z" fill="#fff7ed" opacity="0.55" />
          <path d="M0 44 L150 44 L120 76 L26 76 Z" fill="#f8fafc" />
          <path d="M40 44 L120 20 L150 44 Z" fill="#d97706" />
          <rect x="46" y="24" width="52" height="20" rx="6" fill="#7dd3fc" />
          <path d="M0 44 L150 44 L146 52 L4 52 Z" fill="#0f172a" />
          <circle cx="70" cy="14" r="10" fill="#fca5a5" />
        </g>
      </g>
    </g>

    <!-- ============ SCENE 6 : MARKA ============ -->
    <g class="scene s6">
      <rect width="1200" height="675" fill="url(#hi-brand)" />
      <circle cx="600" cy="250" r="150" fill="#d97706" opacity="0.12" />
      <g stroke="#d97706" stroke-width="3" opacity="0.25" fill="none">
        <path d="M0 470 q60 -22 120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0" />
        <path d="M0 520 q60 -22 120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0" />
      </g>
      <text class="brand-title" x="600" y="330" text-anchor="middle" font-family="Playfair Display, serif" font-size="86" font-weight="700" fill="#f8fafc">Phuket Tatili</text>
      <rect class="brand-line" x="470" y="356" width="260" height="5" rx="3" fill="#d97706" />
      <text class="brand-sub" x="600" y="410" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="30" font-weight="300" fill="#cbd5e1">Havaalanından cennete, her anı biz planlıyoruz.</text>
    </g>
  </svg>

  <div class="intro-progress"><span class="intro-progress-bar"></span></div>
  <button type="button" class="intro-skip" data-skip>Atla <span aria-hidden="true">✕</span></button>
</div>

<style>
  .hero-intro {
    position: absolute; inset: 0; z-index: 30; overflow: hidden;
    background: #0f172a; pointer-events: auto;
    animation: hi-out 620ms ease forwards; animation-delay: 7200ms;
  }
  .intro-svg { width: 100%; height: 100%; display: block; }
  .scene { opacity: 0; }

  @keyframes hi-out { to { opacity: 0; visibility: hidden; pointer-events: none; } }
  @keyframes s-fade { 0% { opacity: 0; } 10% { opacity: 1; } 84% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes s-in { from { opacity: 0; } to { opacity: 1; } }

  .s1 { animation: s-fade 1400ms ease forwards; animation-delay: 0ms; }
  .s2 { animation: s-fade 1400ms ease forwards; animation-delay: 1250ms; }
  .s3 { animation: s-fade 1400ms ease forwards; animation-delay: 2500ms; }
  .s4 { animation: s-fade 1400ms ease forwards; animation-delay: 3750ms; }
  .s5 { animation: s-fade 1350ms ease forwards; animation-delay: 5000ms; }
  .s6 { animation: s-in 900ms ease forwards; animation-delay: 6100ms; }

  /* güneş */
  @keyframes hi-pulse { 0%,100% { transform: scale(1); opacity: .95; } 50% { transform: scale(1.06); opacity: 1; } }
  .sun { transform-origin: 960px 150px; animation: hi-pulse 3s ease-in-out infinite; }
  @keyframes hi-spin { to { transform: rotate(360deg); } }
  .rays { transform-origin: 960px 150px; animation: hi-spin 24s linear infinite; }

  /* bulutlar */
  @keyframes hi-drift { from { transform: translateX(-60px); } to { transform: translateX(1260px); } }
