  @keyframes hi-out-fast { to { opacity: 0; visibility: hidden; pointer-events: none; } }
  .hero-intro.is-skipped { animation: hi-out-fast 380ms ease forwards; animation-delay: 0ms; }

  @media (prefers-reduced-motion: reduce) {
    .hero-intro { animation: none; opacity: 0; visibility: hidden; pointer-events: none; }
  }
</style>

<script>
  const setupHeroIntro = () => {
    const intro = document.getElementById('hero-intro');
    if (!intro) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { intro.remove(); return; }

    const finish = () => {
      intro.classList.add('is-skipped');
      window.setTimeout(() => intro.remove(), 420);
    };

    intro.querySelector('[data-skip]')?.addEventListener('click', (e) => { e.stopPropagation(); finish(); });
    intro.addEventListener('click', finish);
    // Emniyet: CSS zaten 7.8s'de gizler; DOM'dan da temizle.
    window.setTimeout(() => intro.remove(), 8000);
  };

  document.addEventListener('astro:page-load', setupHeroIntro);
</script>
