---
import FadeIn from '../ui/FadeIn';
---

<!-- Features / Why Choose Us -->
<section class="py-24 bg-slate-900 relative overflow-hidden px-4 text-white">
  <!-- Subtle Background Ambient Glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-brand-accent/15 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute -bottom-20 right-10 w-[400px] h-[300px] bg-emerald-500/10 blur-[100px] rounded-full pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Section Title -->
    <FadeIn client:visible delay={0.1}>
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-accent/20 border border-brand-accent/30 text-amber-300 text-xs font-bold uppercase tracking-widest">
          ★ Neden Phuket Tatili?
        </span>
        <h2 class="text-3xl md:text-5xl font-serif font-bold text-white mt-4">
          Ayrıcalıklı, Güvenli ve Tamamen Size Özel
        </h2>
        <p class="text-slate-300 text-base md:text-lg mt-4 font-light leading-relaxed">
          Standart turların karmaşasından uzak, Tayland'daki yerel ekibimizle her anınız güvence altında.
        </p>
      </div>
    </FadeIn>

    <!-- 3 Feature Cards with Images, Icons & Rich Micro-Details -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- 1. Güvenli Seyahat -->
      <FadeIn client:visible delay={0.2} direction="up">
        <div class="group relative rounded-3xl overflow-hidden bg-slate-800/90 border border-slate-700/80 hover:border-emerald-500/60 transition-all duration-500 shadow-xl hover:shadow-2xl hover:-translate-y-2 flex flex-col h-full">
          <!-- Visual Header -->
          <div class="relative h-48 overflow-hidden">
            <img
              src="/assets/beach.webp"
              alt="Güvenli ve Lisanslı Turlar"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
            
            <!-- Floating Icon Badge -->
            <div class="absolute bottom-4 left-6 w-12 h-12 rounded-2xl bg-emerald-500 text-white flex items-center justify-center shadow-lg shadow-emerald-500/30 transform group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>

            <!-- Top Pill -->
            <div class="absolute top-4 right-4 bg-slate-900/80 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-semibold text-emerald-400 border border-emerald-500/30">
              Tam Güvence
            </div>
          </div>

          <!-- Content -->
          <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow">
            <div>
              <h3 class="text-2xl font-serif font-bold text-white group-hover:text-emerald-400 transition-colors mb-3">
                Güvenli Seyahat
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6 font-light">
                Tüm ada ve doğa turlarımız resmi Tayland Turizm Otoritesi (TAT) lisanslı tekneler ve tam kapsamlı yolcu sigortasıyla gerçekleştirilir.
              </p>
            </div>

            <ul class="space-y-2.5 pt-4 border-t border-slate-700/60 text-xs text-slate-300">
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Resmi TAT Lisanslı Deniz Araçları</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Her Turda Bireysel Ferdi Kaza Sigortası</span>
              </li>
            </ul>
          </div>
        </div>
      </FadeIn>

      <!-- 2. 7/24 Türkçe Destek -->
      <FadeIn client:visible delay={0.35} direction="up">
        <div class="group relative rounded-3xl overflow-hidden bg-slate-800/90 border border-slate-700/80 hover:border-[#25D366]/60 transition-all duration-500 shadow-xl hover:shadow-2xl hover:-translate-y-2 flex flex-col h-full">
          <!-- Visual Header -->
          <div class="relative h-48 overflow-hidden">
            <img
              src="/assets/culture.webp"
              alt="7/24 Türkçe Rehberlik ve Yerel Destek"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
            
            <!-- Floating Icon Badge -->
            <div class="absolute bottom-4 left-6 w-12 h-12 rounded-2xl bg-[#25D366] text-white flex items-center justify-center shadow-lg shadow-green-500/30 transform group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </div>

            <!-- Top Pill -->
            <div class="absolute top-4 right-4 bg-slate-900/80 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-semibold text-green-400 border border-green-500/30">
              Yerel Ekip
            </div>
          </div>

          <!-- Content -->
          <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow">
            <div>
              <h3 class="text-2xl font-serif font-bold text-white group-hover:text-green-400 transition-colors mb-3">
                7/24 Türkçe Destek
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6 font-light">
                Phuket'te yaşayan yerel ekibimiz inişinizden dönüşünüze kadar WhatsApp üzerinden kesintisiz yanınızda. Dil sorunu yaşamadan tatil yapın.
              </p>
            </div>

            <ul class="space-y-2.5 pt-4 border-t border-slate-700/60 text-xs text-slate-300">
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Anında WhatsApp & Telefon İletişimi</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Restoran, Rota ve Alışveriş Tavsiyeleri</span>
              </li>
            </ul>
          </div>
        </div>
      </FadeIn>

      <!-- 3. VIP Deneyim -->
      <FadeIn client:visible delay={0.5} direction="up">
        <div class="group relative rounded-3xl overflow-hidden bg-slate-800/90 border border-slate-700/80 hover:border-amber-400/60 transition-all duration-500 shadow-xl hover:shadow-2xl hover:-translate-y-2 flex flex-col h-full">
          <!-- Visual Header -->
          <div class="relative h-48 overflow-hidden">
            <img
              src="/assets/yacht.webp"
              alt="VIP Deneyim ve Özel Rotalar"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
            
            <!-- Floating Icon Badge -->
            <div class="absolute bottom-4 left-6 w-12 h-12 rounded-2xl bg-amber-500 text-white flex items-center justify-center shadow-lg shadow-amber-500/30 transform group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
              </svg>
            </div>

            <!-- Top Pill -->
            <div class="absolute top-4 right-4 bg-slate-900/80 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-semibold text-amber-400 border border-amber-500/30">
              Ayrıcalıklı Rota
            </div>
          </div>

          <!-- Content -->
          <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow">
            <div>
              <h3 class="text-2xl font-serif font-bold text-white group-hover:text-amber-400 transition-colors mb-3">
                VIP Deneyim
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6 font-light">
                Kalabalıktan izole özel yat turları, lüks şoförlü transferler ve sadece size özel planlanan esnek saatli ada rotaları.
              </p>
            </div>

            <ul class="space-y-2.5 pt-4 border-t border-slate-700/60 text-xs text-slate-300">
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Özel Yat & Katamaran Kiralama</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Kişiye Özel Konforlu VIP Araçlar</span>
              </li>
            </ul>
          </div>
        </div>
      </FadeIn>
    </div>
  </div>
</section>
