---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tracking from '../components/Tracking.astro';
import siteSettings from '../content/settings/site.json';

const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';

interface Props {
	title: string;
	description?: string;
    image?: string;
    ogType?: 'website' | 'article';
    publishedTime?: string;
    /** Sayfa başlığı marka son ekini ("| Phuket Tatili") zaten içeriyorsa true */
    noTitleSuffix?: boolean;
    /** Sayfaya özel ek JSON-LD şemaları (Article, Product, FAQPage vb.) */
    schemas?: Record<string, unknown>[];
}

const {
  title,
  description = "Phuket Tatili - En özel anılarınız için lüks ve ayrıcalıklı seyahat deneyimleri.",
  image = "/assets/phuket_hero.jpg",
  ogType = 'website',
  publishedTime,
  noTitleSuffix = false,
  schemas = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://phukettatili.com');
const imageURL = new URL(image, Astro.site || 'https://phukettatili.com');
const fullTitle = noTitleSuffix ? title : `${title} | Phuket Tatili`;
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
        
        <!-- SEO & OpenGraph -->
        <title>{fullTitle}</title>
		<meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <meta property="og:type" content={ogType} />
        <meta property="og:locale" content="tr_TR" />
        <meta property="og:site_name" content="Phuket Tatili" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />

        <!-- JSON-LD Structured Data -->
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "TravelAgency",
          "name": "Phuket Tatili",
          "url": (Astro.site || 'https://phukettatili.com').toString(),
          "image": new URL("/assets/phuket_hero.jpg", Astro.site || 'https://phukettatili.com').toString(),
          "description": "Phuket Tatili - Lüks VIP Turlar ve Yat Kiralama",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Phuket",
            "addressCountry": "TH"
          },
          "telephone": "+66 82 895 0665"
        })} />
        {schemas.map((schema) => (
          <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...schema })} />
        ))}

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
		
        <ClientRouter />

        <!-- Dark Mode Setup -->
        <script is:inline>
          const applyTheme = () => {
            const theme = (() => {
              if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                return localStorage.getItem('theme');
              }
              if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                return 'dark';
              }
              return 'light';
            })();
            if (theme === 'light') {
              document.documentElement.classList.remove('dark');
            } else {
              document.documentElement.classList.add('dark');
            }
            window.localStorage.setItem('theme', theme);
          };
          applyTheme();
          document.addEventListener('astro:after-swap', applyTheme);
        </script>
        
        <Tracking />
	</head>
	<body class="flex flex-col min-h-screen relative">
        <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
        <Header />
        <main class="flex-grow pt-20">
		    <slot />
        </main>
        <Footer />
        
        <!-- Floating WhatsApp -->
        <a href={`https://wa.me/${whatsappNumber}`} target="_blank" class="premium-whatsapp fixed bottom-6 right-6 bg-[#25D366] text-white p-4 rounded-full shadow-2xl hover:scale-110 hover:bg-[#128C7E] transition-all z-50 flex items-center justify-center group" aria-label="WhatsApp ile ulaşın">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span class="absolute right-full mr-4 bg-white text-slate-800 text-sm font-bold px-3 py-1.5 rounded-lg shadow-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">Hemen Ulaşın</span>
        </a>

        <script>
          document.addEventListener('astro:page-load', () => {
            // Premium kartlarda imleci takip eden spot ışığı
            if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches ||
                window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            const onMove = (e: PointerEvent) => {
              const card = (e.currentTarget as HTMLElement);
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
              card.style.setProperty('--my', `${e.clientY - rect.top}px`);
            };
            document.querySelectorAll<HTMLElement>('.premium-card').forEach((card) => {
              card.addEventListener('pointermove', onMove);
            });
          });

          document.addEventListener('astro:page-load', () => {
            const bar = document.getElementById('scroll-progress');
            if (!bar) return;
            let raf = 0;
            const update = () => {
              raf = 0;
              const max = document.documentElement.scrollHeight - window.innerHeight;
              const pct = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
              bar.style.transform = `scaleX(${pct})`;
            };
            const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
            window.removeEventListener('scroll', (window as any)._onProgressScroll);
            (window as any)._onProgressScroll = onScroll;
            window.addEventListener('scroll', onScroll, { passive: true });
            update();
          });
        </script>
	</body>
</html>
