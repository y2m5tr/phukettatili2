---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FadeIn from '../../components/ui/FadeIn';

export const prerender = true;

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a: any, b: any) => {
  const dateA = new Date(a.data.date || 0).getTime();
  const dateB = new Date(b.data.date || 0).getTime();
  return dateB - dateA;
});
---

<Layout title="Phuket Rehberi & Blog — Phuket Tatili" description="Phuket hava durumu, gezilecek yerler ve ada rehberi.">
  <div class="bg-brand-primary text-white py-20 px-4 relative overflow-hidden">
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <FadeIn client:load direction="up">
        <span class="inline-block bg-brand-accent text-white px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase mb-4 shadow-lg">
          Seyahat İpuçları & Rehber
        </span>
        <h1 class="text-4xl md:text-6xl font-serif font-bold mb-4">Phuket Rehberi</h1>
        <p class="text-slate-300 text-base md:text-lg max-w-xl mx-auto font-light">
          Tayland seyahatinizi kusursuz kılacak güncel bilgiler, hava durumu tavsiyeleri ve rota önerileri.
        </p>
      </FadeIn>
    </div>
  </div>

  <section class="py-20 bg-slate-50 dark:bg-[#0a0f1a] px-4 min-h-[500px]">
    <div class="max-w-6xl mx-auto">
      {sortedPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post: any, index: number) => (
            <FadeIn client:visible delay={0.1 * index} direction="up">
              <a href={`/blog/${post.id}`} class="group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow-lg hover:shadow-2xl transition-all duration-300 border border-slate-100 dark:border-slate-700">
                <div class="relative h-60 overflow-hidden">
                  <img
                    src={post.data.cover_image ? `/assets/${post.data.cover_image}` : '/assets/beach.webp'}
                    alt={post.data.title}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-brand-primary/20 group-hover:bg-transparent transition-colors duration-500"></div>
                </div>
                <div class="p-6">
                  <h2 class="text-xl font-bold mb-2 group-hover:text-brand-accent transition-colors text-brand-primary dark:text-white line-clamp-2">
                    {post.data.title}
                  </h2>
                  <p class="text-slate-600 dark:text-slate-300 text-sm mb-4 line-clamp-3">
                    {post.data.excerpt}
                  </p>
                  <div class="flex justify-between items-center border-t border-slate-100 dark:border-slate-700 pt-4 text-xs text-slate-500">
                    <span>{post.data.author || 'Phuket Tatili Ekibi'}</span>
                    <span class="text-brand-accent font-semibold">Devamını Oku →</span>
                  </div>
                </div>
              </a>
            </FadeIn>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 text-slate-500">Yeni rehber yazıları hazırlanıyor...</div>
      )}
    </div>
  </section>
</Layout>
