---
const clientId = process.env.KEYSTATIC_GITHUB_CLIENT_ID || 'MISSING';
const clientSecret = process.env.KEYSTATIC_GITHUB_CLIENT_SECRET || 'MISSING';
const secret = process.env.KEYSTATIC_SECRET || 'MISSING';
const slug = process.env.PUBLIC_KEYSTATIC_GITHUB_APP_SLUG || 'MISSING';
---
<html>
<body>
  <p>Client ID: {clientId}</p>
  <p>Client Secret: {clientSecret.substring(0,4)}... (length: {clientSecret.length})</p>
  <p>Keystatic Secret: {secret}</p>
  <p>Slug: {slug}</p>
</body>
</html>
