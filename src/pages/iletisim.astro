---
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/ui/FadeIn';

export const prerender = true;
---

<Layout title="İletişim" description="Bize ulaşın, hayalinizdeki tatili birlikte planlayalım.">
  <div class="bg-brand-primary text-white py-24 px-4 relative">
    <div class="relative max-w-4xl mx-auto text-center z-10">
      <FadeIn client:load direction="up">
        <h1 class="text-4xl md:text-6xl font-serif font-bold mb-6">İletişim</h1>
      </FadeIn>
      <FadeIn client:load delay={0.2} direction="up">
        <p class="text-slate-300 text-lg font-light">Bize dilediğiniz an 7/24 ulaşabilirsiniz.</p>
      </FadeIn>
    </div>
  </div>

  <section class="py-24 bg-white px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16">
      
      <!-- Contact Info -->
      <FadeIn client:visible direction="right">
        <div>
          <h2 class="text-3xl font-serif text-brand-primary font-bold mb-8">Bize Ulaşın</h2>
          
          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-brand-accent/10 rounded-full flex items-center justify-center text-brand-accent shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-800 mb-1">WhatsApp / Telefon</h4>
                <p class="text-slate-600 mb-2">Hızlı rezervasyon ve Türkçe destek için:</p>
                <a href="https://wa.me/66828950665" target="_blank" class="text-brand-accent font-bold hover:underline">+66 82 895 0665</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-brand-accent/10 rounded-full flex items-center justify-center text-brand-accent shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-800 mb-1">E-Posta</h4>
                <p class="text-slate-600 mb-2">Özel talepleriniz ve grup indirimleri için:</p>
                <a href="mailto:info@phukettatili.com" class="text-brand-accent font-bold hover:underline">info@phukettatili.com</a>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-brand-accent/10 rounded-full flex items-center justify-center text-brand-accent shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-800 mb-1">Merkez Ofis</h4>
                <p class="text-slate-600">Phuket, Tayland (Randevu ile kabul edilmektedir)</p>
              </div>
            </div>
          </div>
        </div>
      </FadeIn>

      <!-- Contact Form -->
      <FadeIn client:visible delay={0.2} direction="left">
        <div class="bg-slate-50 p-8 rounded-3xl shadow-sm border border-slate-100">
          <h3 class="text-2xl font-bold text-brand-primary mb-6">Mesaj Gönderin</h3>

          <div id="contact-success-msg" class="hidden mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm font-medium">
            Mesajınız başarıyla iletildi! Ekibimiz en kısa sürede sizinle iletişime geçecektir.
          </div>

          <form 
            name="contact" 
            method="POST" 
            data-netlify="true" 
            action="/iletisim?success=true" 
            class="space-y-4"
          >
            <input type="hidden" name="form-name" value="contact" />
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Adınız Soyadınız</label>
              <input type="text" name="name" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-white transition-all" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">E-Posta Adresiniz</label>
              <input type="email" name="email" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-white transition-all" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">WhatsApp / Telefon Numaranız</label>
              <input type="tel" name="phone" placeholder="+90 veya +66..." class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-white transition-all" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Mesajınız</label>
              <textarea name="message" rows="4" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-white transition-all"></textarea>
            </div>
            <button type="submit" class="w-full bg-brand-primary text-white py-4 rounded-xl font-bold hover:bg-brand-accent transition-colors shadow-lg mt-2">
              Gönder
            </button>
          </form>
        </div>
      </FadeIn>
      
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    if (new URLSearchParams(window.location.search).get('success') === 'true') {
      const msg = document.getElementById('contact-success-msg');
      if (msg) msg.classList.remove('hidden');
    }
  });
</script>
