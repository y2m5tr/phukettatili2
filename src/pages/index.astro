---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import FadeIn from '../components/ui/FadeIn';
import Accordion from '../components/ui/Accordion';
import HeroSlider from '../components/HeroSlider.astro';
import testimonialsData from '../content/settings/testimonials.json';
import faqData from '../content/settings/faq.json';
import homeData from '../content/pages/home.json';
import siteSettings from '../content/settings/site.json';

export const prerender = true;

const tours = await getCollection('tours');
const featuredTours = tours.filter((tour: any) => tour.data.featured).slice(0, 3);

const testimonials = testimonialsData?.testimonials || [];
const formattedFaqs = (faqData?.faq || []).map((item: any) => ({
  q: item.question,
  a: item.answer,
}));
const waUrl = `https://wa.me/${siteSettings?.whatsappNumber || '66828950665'}`;
const instagramUrl = siteSettings?.instagramUrl || 'https://instagram.com/phukettatili';

const guestMoments = [
  {
    image: 'couple.webp',
    title: 'Phi Phi & Maya Bay',
    tag: 'Balayı & Çift Rotaları',
    location: 'Phi Phi Adaları',
  },
  {
    image: 'yacht.webp',
    title: 'Özel Katamaran Seyri',
    tag: 'VIP Rotalar & Gün Batımı',
    location: 'Promthep & Racha',
  },
  {
    image: 'family.webp',
    title: 'Ailece Eğlenceli Keşif',
    tag: 'Şehir & Ada Rotaları',
    location: 'Phuket & Coral Island',
  },
  {
    image: 'underwater.webp',
    title: 'Zümrüt Lagün & Şnorkel',
    tag: 'Sualtı Dünyası',
    location: 'Pi Leh & Similan',
  },
  {
    image: 'beachclub.webp',
    title: 'Tropik Kumsal & Dinlenme',
    tag: 'Plaj & Yaşam',
    location: 'Bang Tao & Beach Club',
  },
];
---

<Layout title="Ana Sayfa" description="Tayland'ın incisi Phuket'te unutulmaz bir tatil deneyimi.">
  <!-- Hero Section -->
  <section class="relative h-[80vh] min-h-[600px] flex items-center justify-center overflow-hidden">
    <HeroSlider />

    <div class="relative z-20 text-center px-4 max-w-4xl mx-auto mt-16">
      <FadeIn client:load delay={0.2} direction="up">
        <h1 class="text-5xl md:text-7xl text-white mb-6 drop-shadow-lg leading-tight">
          {homeData?.heroTitle || "Phuket'in Büyüsünü Keşfedin"}
        </h1>
      </FadeIn>
      <FadeIn client:load delay={0.4} direction="up">
        <p class="text-lg md:text-xl text-slate-200 mb-10 max-w-2xl mx-auto font-light">
          {homeData?.heroSubtitle || "Size özel tasarlanmış turlar, gizli kalmış cennet koylar ve unutulmaz anılar için en doğru yerdesiniz."}
        </p>
      </FadeIn>
      <FadeIn client:load delay={0.6} direction="up">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/turlar" class="premium-cta bg-brand-accent hover:bg-brand-accent/90 text-white px-8 py-4 rounded-full font-medium transition-all transform hover:scale-105 shadow-xl">
            Turları İncele
          </a>
          <a href={waUrl} target="_blank" class="premium-cta bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/30 px-8 py-4 rounded-full font-medium transition-all transform hover:scale-105 shadow-xl">
            WhatsApp'tan Ulaşın
          </a>
        </div>
      </FadeIn>
    </div>
  </section>

  <!-- Bento Grid: Phuket'te Neler Yapabilirsiniz? -->
  <section class="py-20 bg-white dark:bg-[#0a0f1a] px-4 border-b border-slate-100 dark:border-slate-800/60">
    <div class="max-w-7xl mx-auto">
      <FadeIn client:visible delay={0.1}>
        <div class="text-center mb-14">
          <span class="text-xs uppercase tracking-widest text-brand-accent font-bold">Deneyimler & Rotalar</span>
          <h2 class="text-3xl md:text-5xl font-serif font-bold text-brand-primary dark:text-white mt-2">
            Phuket'te Neler Yapabilirsiniz?
          </h2>
          <p class="text-slate-600 dark:text-slate-300 max-w-2xl mx-auto text-sm md:text-base font-light mt-3 leading-relaxed">
            Günübirlik tropik ada kaçamaklarından özel yat turlarına, konforlu VIP transferlerden etik doğa deneyimlerine kadar Phuket'in en iyileri.
          </p>
        </div>
      </FadeIn>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
        <!-- 1. Ada Turları (7 Cols) -->
        <div class="lg:col-span-7">
          <FadeIn client:visible delay={0.15} direction="up" className="h-full">
            <a
              href="/tur-kategorisi/island-tours"
              class="group relative block h-[380px] lg:h-[420px] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-200/40 dark:border-white/10"
            >
              <img
                src="/assets/pileh.webp"
                alt="Phuket Ada Turları"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/45 to-transparent"></div>
              
              <div class="absolute top-5 left-5 z-10">
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold border border-white/20">
                  🏝️ Ada Turları
                </span>
              </div>

              <div class="absolute bottom-0 left-0 right-0 p-7 lg:p-9 z-10">
                <h3 class="font-serif text-2xl lg:text-3xl font-bold text-white group-hover:text-brand-accent transition-colors leading-snug">
                  Phi Phi, Maya Bay, James Bond & Similan
                </h3>
                <p class="text-slate-300 text-sm mt-2 max-w-lg leading-relaxed line-clamp-2">
                  Zümrüt yeşili lagünler, kireçtaşı kayalıklar ve bembeyaz kumsallarda unutulmaz ada keşifleri.
                </p>
                <div class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-brand-accent group-hover:text-white transition-colors">
                  Rotaları Keşfet <span class="transform group-hover:translate-x-1 transition-transform">→</span>
                </div>
              </div>
            </a>
          </FadeIn>
        </div>

        <!-- 2. Özel Yat & Katamaran (5 Cols) -->
        <div class="lg:col-span-5">
          <FadeIn client:visible delay={0.25} direction="up" className="h-full">
            <a
              href="/vip"
              class="group relative block h-[380px] lg:h-[420px] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-200/40 dark:border-white/10"
            >
              <img
                src="/assets/yacht.webp"
                alt="Özel Yat ve Katamaran Kiralama"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/45 to-transparent"></div>
              
              <div class="absolute top-5 left-5 z-10">
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold border border-white/20">
                  🛥️ Özel Kiralama
                </span>
              </div>

              <div class="absolute bottom-0 left-0 right-0 p-7 lg:p-9 z-10">
                <h3 class="font-serif text-2xl lg:text-3xl font-bold text-white group-hover:text-brand-accent transition-colors leading-snug">
                  Özel Yat & Katamaran
                </h3>
                <p class="text-slate-300 text-sm mt-2 leading-relaxed line-clamp-2">
                  Size ve sevdiklerinize özel, kalabalıktan uzak izole koylar ve esnek rotalar.
                </p>
                <div class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-brand-accent group-hover:text-white transition-colors">
                  VIP Seçenekler <span class="transform group-hover:translate-x-1 transition-transform">→</span>
                </div>
              </div>
            </a>
          </FadeIn>
        </div>

        <!-- 3. VIP Transferler (4 Cols) -->
        <div class="md:col-span-1 lg:col-span-4">
          <FadeIn client:visible delay={0.3} direction="up" className="h-full">
            <a
              href="/transferler"
              class="group relative block h-[320px] lg:h-[350px] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-200/40 dark:border-white/10"
            >
              <img
                src="/assets/phuket_transfer.jpg"
                alt="Phuket VIP Transferler"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent"></div>
              
              <div class="absolute top-5 left-5 z-10">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold border border-white/20">
                  🚐 VIP Transfer
                </span>
              </div>

              <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
                <h3 class="font-serif text-xl lg:text-2xl font-bold text-white group-hover:text-brand-accent transition-colors">
                  Havalimanı & Ada Transferi
                </h3>
                <p class="text-slate-300 text-xs sm:text-sm mt-1.5 leading-relaxed line-clamp-2">
                  Özel şoförlü, lüks VIP araçlarla konforlu ve dakik ulaşım.
                </p>
                <div class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-brand-accent group-hover:text-white transition-colors">
                  İncele <span>→</span>
                </div>
              </div>
            </a>
          </FadeIn>
        </div>

        <!-- 4. Etik Fil Barınakları (4 Cols) -->
        <div class="md:col-span-1 lg:col-span-4">
          <FadeIn client:visible delay={0.35} direction="up" className="h-full">
            <a
              href="/tur-kategorisi/elephant"
              class="group relative block h-[320px] lg:h-[350px] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-200/40 dark:border-white/10"
            >
              <img
                src="/assets/elephant.webp"
                alt="Phuket Etik Fil Barınağı Deneyimi"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent"></div>
              
              <div class="absolute top-5 left-5 z-10">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold border border-white/20">
                  🐘 Doğa Deneyimi
                </span>
              </div>

              <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
                <h3 class="font-serif text-xl lg:text-2xl font-bold text-white group-hover:text-brand-accent transition-colors">
                  Etik Fil Barınakları
                </h3>
                <p class="text-slate-300 text-xs sm:text-sm mt-1.5 leading-relaxed line-clamp-2">
                  Zincirsiz, hayvan refahına uygun doğal koruma alanlarında besleme ve bakım.
                </p>
                <div class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-brand-accent group-hover:text-white transition-colors">
                  İncele <span>→</span>
                </div>
              </div>
            </a>
          </FadeIn>
        </div>

        <!-- 5. Kültür & Sahne Şovları (4 Cols) -->
        <div class="md:col-span-2 lg:col-span-4">
          <FadeIn client:visible delay={0.4} direction="up" className="h-full">
            <a
              href="/tur-kategorisi/entertainment-tours"
              class="group relative block h-[320px] lg:h-[350px] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-200/40 dark:border-white/10"
            >
              <img
                src="/assets/culture.webp"
                alt="Phuket Kültür ve Sahne Şovları"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent"></div>
              
              <div class="absolute top-5 left-5 z-10">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold border border-white/20">
                  🎭 Sahne & Eğlence
                </span>
              </div>

              <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
                <h3 class="font-serif text-xl lg:text-2xl font-bold text-white group-hover:text-brand-accent transition-colors">
                  Kültür & Sahne Şovları
                </h3>
                <p class="text-slate-300 text-xs sm:text-sm mt-1.5 leading-relaxed line-clamp-2">
                  Carnival Magic, Simon Cabaret ve Siam Niramit ışık ve dans gösterileri.
                </p>
                <div class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-brand-accent group-hover:text-white transition-colors">
                  İncele <span>→</span>
                </div>
              </div>
            </a>
          </FadeIn>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Tours -->
  <section class="py-24 bg-slate-50 dark:bg-[#0a0f1a] px-4 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <FadeIn client:visible delay={0.1}>
        <div class="text-center mb-16">
          <h2 class="text-sm tracking-widest uppercase text-brand-accent font-sans font-bold mb-3">Öne Çıkanlar</h2>
          <h3 class="text-4xl md:text-5xl text-brand-primary dark:text-white font-serif font-bold">En Çok Tercih Edilen Rotalar</h3>
        </div>
      </FadeIn>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredTours.length > 0 ? featuredTours.map((tour: any, index: number) => (
          <FadeIn client:visible delay={0.2 + (index * 0.15)} direction="up">
            <a href={`/turlar/${tour.id}`} class="premium-card group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow-lg hover:shadow-2xl transition-all duration-300 border border-slate-100 dark:border-slate-700">
              <div class="relative h-64 overflow-hidden">
                <img 
                  src={`/assets/${tour.data.image}`} 
                  alt={tour.data.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-brand-primary/20 group-hover:bg-transparent transition-colors duration-500"></div>
                <div class="absolute top-4 right-4 bg-white/90 backdrop-blur text-brand-primary text-xs font-bold px-3 py-1 rounded-full">
                  {tour.data.category_label || 'Özel Tur'}
                </div>
              </div>
              <div class="p-6">
                <h4 class="text-xl font-bold mb-2 group-hover:text-brand-accent transition-colors text-brand-primary dark:text-white">{tour.data.title}</h4>
                <p class="text-slate-600 dark:text-slate-300 text-sm mb-4 line-clamp-2">{tour.data.excerpt}</p>
                <div class="flex justify-between items-center border-t border-slate-100 dark:border-slate-700 pt-4 mt-4">
                  <span class="text-sm font-medium text-slate-500 dark:text-slate-400">{tour.data.duration || 'Tam Gün'}</span>
                  {tour.data.price_thb && tour.data.price_thb > 0 ? (
                    <span class="text-lg font-bold text-brand-primary dark:text-white">{tour.data.price_thb.toLocaleString()} THB</span>
                  ) : (
                    <span class="text-xs font-bold text-brand-accent bg-brand-accent/10 px-2.5 py-1 rounded-full">Fiyat Teklifi Alın</span>
                  )}
                </div>
              </div>
            </a>
          </FadeIn>
        )) : (
          <div class="col-span-3 text-center text-slate-500 py-10">Turlar yükleniyor...</div>
        )}
      </div>
      
      <FadeIn client:visible delay={0.4}>
        <div class="text-center mt-12">
          <a href="/turlar" class="inline-flex items-center text-brand-accent font-bold hover:text-brand-primary transition-colors">
            Tüm Turları Gör 
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
      </FadeIn>
    </div>
  </section>

  <!-- Features / Why Choose Us -->
  <section class="py-24 bg-slate-900 relative overflow-hidden px-4 text-white">
    <!-- Subtle Background Ambient Glows -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-brand-accent/15 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="absolute -bottom-20 right-10 w-[400px] h-[300px] bg-emerald-500/10 blur-[100px] rounded-full pointer-events-none"></div>

    <div class="max-w-6xl mx-auto relative z-10">
      <!-- Section Title -->
      <FadeIn client:visible delay={0.1}>
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-accent/20 border border-brand-accent/30 text-amber-300 text-xs font-bold uppercase tracking-widest">
            ★ Neden Phuket Tatili?
          </span>
          <h2 class="text-3xl md:text-5xl font-serif font-bold text-white mt-4">
            Ayrıcalıklı, Güvenli ve Tamamen Size Özel
          </h2>
          <p class="text-slate-300 text-base md:text-lg mt-4 font-light leading-relaxed">
            Standart turların karmaşasından uzak, Tayland'daki yerel ekibimizle her anınız güvence altında.
          </p>
        </div>
      </FadeIn>

      <!-- 3 Feature Cards with Images, Icons & Rich Micro-Details -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- 1. Güvenli Seyahat -->
        <FadeIn client:visible delay={0.2} direction="up">
          <div class="group relative rounded-3xl overflow-hidden bg-slate-800/90 border border-slate-700/80 hover:border-emerald-500/60 transition-all duration-500 shadow-xl hover:shadow-2xl hover:-translate-y-2 flex flex-col h-full">
            <!-- Visual Header -->
            <div class="relative h-48 overflow-hidden">
              <img
                src="/assets/beach.webp"
                alt="Güvenli ve Lisanslı Turlar"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
              
              <!-- Floating Icon Badge -->
              <div class="absolute bottom-4 left-6 w-12 h-12 rounded-2xl bg-emerald-500 text-white flex items-center justify-center shadow-lg shadow-emerald-500/30 transform group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>

              <!-- Top Pill -->
              <div class="absolute top-4 right-4 bg-slate-900/80 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-semibold text-emerald-400 border border-emerald-500/30">
                Tam Güvence
              </div>
            </div>

            <!-- Content -->
            <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow">
              <div>
                <h3 class="text-2xl font-serif font-bold text-white group-hover:text-emerald-400 transition-colors mb-3">
                  Güvenli Seyahat
                </h3>
                <p class="text-slate-300 text-sm leading-relaxed mb-6 font-light">
                  Tüm ada ve doğa turlarımız resmi Tayland Turizm Otoritesi (TAT) lisanslı tekneler ve tam kapsamlı yolcu sigortasıyla gerçekleştirilir.
                </p>
              </div>

              <ul class="space-y-2.5 pt-4 border-t border-slate-700/60 text-xs text-slate-300">
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                  <span>Resmi TAT Lisanslı Deniz Araçları</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                  <span>Her Turda Bireysel Ferdi Kaza Sigortası</span>
                </li>
              </ul>
            </div>
          </div>
        </FadeIn>

        <!-- 2. 7/24 Türkçe Destek -->
        <FadeIn client:visible delay={0.35} direction="up">
          <div class="group relative rounded-3xl overflow-hidden bg-slate-800/90 border border-slate-700/80 hover:border-[#25D366]/60 transition-all duration-500 shadow-xl hover:shadow-2xl hover:-translate-y-2 flex flex-col h-full">
            <!-- Visual Header -->
            <div class="relative h-48 overflow-hidden">
              <img
                src="/assets/culture.webp"
                alt="7/24 Türkçe Rehberlik ve Yerel Destek"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
              
              <!-- Floating Icon Badge -->
              <div class="absolute bottom-4 left-6 w-12 h-12 rounded-2xl bg-[#25D366] text-white flex items-center justify-center shadow-lg shadow-green-500/30 transform group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
