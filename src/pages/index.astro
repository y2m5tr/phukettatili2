---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import FadeIn from '../components/ui/FadeIn';
import Accordion from '../components/ui/Accordion';
import HeroSlider from '../components/HeroSlider.astro';
import testimonialsData from '../content/settings/testimonials.json';
import faqData from '../content/settings/faq.json';
import homeData from '../content/pages/home.json';
import siteSettings from '../content/settings/site.json';

export const prerender = true;

const tours = await getCollection('tours');
const featuredTours = tours.filter((tour: any) => tour.data.featured).slice(0, 3);

const testimonials = testimonialsData?.testimonials || [];
const formattedFaqs = (faqData?.faq || []).map((item: any) => ({
  q: item.question,
  a: item.answer,
}));
const waUrl = `https://wa.me/${siteSettings?.whatsappNumber || '66828950665'}`;
---

<Layout title="Ana Sayfa" description="Tayland'ın incisi Phuket'te unutulmaz bir tatil deneyimi.">
  <!-- Hero Section -->
  <section class="relative h-[80vh] min-h-[600px] flex items-center justify-center overflow-hidden">
    <HeroSlider />

    <div class="relative z-20 text-center px-4 max-w-4xl mx-auto mt-16">
      <FadeIn client:load delay={0.2} direction="up">
        <h1 class="text-5xl md:text-7xl text-white mb-6 drop-shadow-lg leading-tight">
          {homeData?.heroTitle || "Phuket'in Büyüsünü Keşfedin"}
        </h1>
      </FadeIn>
      <FadeIn client:load delay={0.4} direction="up">
        <p class="text-lg md:text-xl text-slate-200 mb-10 max-w-2xl mx-auto font-light">
          {homeData?.heroSubtitle || "Size özel tasarlanmış turlar, gizli kalmış cennet koylar ve unutulmaz anılar için en doğru yerdesiniz."}
        </p>
      </FadeIn>
      <FadeIn client:load delay={0.6} direction="up">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/turlar" class="premium-cta bg-brand-accent hover:bg-brand-accent/90 text-white px-8 py-4 rounded-full font-medium transition-all transform hover:scale-105 shadow-xl">
            Turları İncele
          </a>
          <a href={waUrl} target="_blank" class="premium-cta bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/30 px-8 py-4 rounded-full font-medium transition-all transform hover:scale-105 shadow-xl">
            WhatsApp'tan Ulaşın
          </a>
        </div>
      </FadeIn>
    </div>
  </section>

  <!-- Featured Tours -->
  <section class="py-24 bg-slate-50 dark:bg-[#0a0f1a] px-4 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <FadeIn client:visible delay={0.1}>
        <div class="text-center mb-16">
          <h2 class="text-sm tracking-widest uppercase text-brand-accent font-sans font-bold mb-3">Öne Çıkanlar</h2>
          <h3 class="text-4xl md:text-5xl text-brand-primary dark:text-white font-serif font-bold">En Çok Tercih Edilen Rotalar</h3>
        </div>
      </FadeIn>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredTours.length > 0 ? featuredTours.map((tour: any, index: number) => (
          <FadeIn client:visible delay={0.2 + (index * 0.15)} direction="up">
            <a href={`/turlar/${tour.id}`} class="premium-card group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow-lg hover:shadow-2xl transition-all duration-300 border border-slate-100 dark:border-slate-700">
              <div class="relative h-64 overflow-hidden">
                <img 
                  src={`/assets/${tour.data.image}`} 
                  alt={tour.data.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-brand-primary/20 group-hover:bg-transparent transition-colors duration-500"></div>
                <div class="absolute top-4 right-4 bg-white/90 backdrop-blur text-brand-primary text-xs font-bold px-3 py-1 rounded-full">
                  {tour.data.category_label || 'Özel Tur'}
                </div>
              </div>
              <div class="p-6">
                <h4 class="text-xl font-bold mb-2 group-hover:text-brand-accent transition-colors text-brand-primary dark:text-white">{tour.data.title}</h4>
                <p class="text-slate-600 dark:text-slate-300 text-sm mb-4 line-clamp-2">{tour.data.excerpt}</p>
                <div class="flex justify-between items-center border-t border-slate-100 dark:border-slate-700 pt-4 mt-4">
                  <span class="text-sm font-medium text-slate-500 dark:text-slate-400">{tour.data.duration || 'Tam Gün'}</span>
                  {tour.data.price_thb && tour.data.price_thb > 0 ? (
                    <span class="text-lg font-bold text-brand-primary dark:text-white">{tour.data.price_thb.toLocaleString()} THB</span>
                  ) : (
                    <span class="text-xs font-bold text-brand-accent bg-brand-accent/10 px-2.5 py-1 rounded-full">Fiyat Teklifi Alın</span>
                  )}
                </div>
              </div>
            </a>
          </FadeIn>
        )) : (
          <div class="col-span-3 text-center text-slate-500 py-10">Turlar yükleniyor...</div>
        )}
      </div>
      
      <FadeIn client:visible delay={0.4}>
        <div class="text-center mt-12">
          <a href="/turlar" class="inline-flex items-center text-brand-accent font-bold hover:text-brand-primary transition-colors">
            Tüm Turları Gör 
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
      </FadeIn>
    </div>
  </section>

  <!-- Features/Benefits -->
  <section class="py-24 bg-brand-primary text-white px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
      <FadeIn client:visible delay={0.1} direction="up">
        <div class="w-16 h-16 bg-brand-accent/20 rounded-full flex items-center justify-center mx-auto mb-6 text-brand-accent transform hover:scale-110 hover:rotate-12 transition-transform duration-300">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <h4 class="text-xl font-bold mb-3">Güvenli Seyahat</h4>
        <p class="text-slate-400 font-light">Tüm turlarımız tam kapsamlı sigorta ile güvence altındadır.</p>
      </FadeIn>
      <FadeIn client:visible delay={0.3} direction="up">
        <div class="w-16 h-16 bg-brand-accent/20 rounded-full flex items-center justify-center mx-auto mb-6 text-brand-accent transform hover:scale-110 hover:-rotate-12 transition-transform duration-300">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        </div>
        <h4 class="text-xl font-bold mb-3">7/24 Türkçe Destek</h4>
        <p class="text-slate-400 font-light">Tayland'daki ekibimizden kesintisiz Türkçe iletişim desteği.</p>
      </FadeIn>
      <FadeIn client:visible delay={0.5} direction="up">
        <div class="w-16 h-16 bg-brand-accent/20 rounded-full flex items-center justify-center mx-auto mb-6 text-brand-accent transform hover:scale-110 hover:rotate-12 transition-transform duration-300">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
        </div>
        <h4 class="text-xl font-bold mb-3">VIP Deneyim</h4>
        <p class="text-slate-400 font-light">Kişiye özel lüks araçlar ve ayrıcalıklı VIP turlar.</p>
      </FadeIn>
    </div>
  </section>

  <!-- Testimonials Section -->
  {testimonials.length > 0 && (
    <section class="py-24 bg-slate-50 dark:bg-[#0a0f1a] px-4">
      <div class="max-w-6xl mx-auto">
        <FadeIn client:visible delay={0.1}>
          <div class="text-center mb-16">
            <span class="text-xs uppercase tracking-widest text-brand-accent font-bold">Misafir Deneyimleri</span>
            <h2 class="text-3xl md:text-5xl text-brand-primary dark:text-white font-serif font-bold mt-2">Bizimle Phuket'i Keşfedenler</h2>
          </div>
        </FadeIn>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {testimonials.map((item: any, idx: number) => (
            <FadeIn client:visible delay={0.15 * idx} direction="up">
              <div class="bg-white dark:bg-slate-800 p-8 rounded-3xl shadow-lg border border-slate-100 dark:border-slate-700 flex flex-col justify-between h-full">
                <div>
                  <div class="flex items-center gap-1 text-amber-400 mb-4">
                    {Array.from({ length: item.stars || 5 }).map(() => (
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                    ))}
                  </div>
                  <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6 italic">
                    "{item.text}"
                  </p>
                </div>
                <div class="border-t border-slate-100 dark:border-slate-700 pt-4">
                  <h4 class="font-bold text-brand-primary dark:text-white text-base">{item.name}</h4>
                  <div class="flex justify-between items-center text-xs text-slate-500 dark:text-slate-400 mt-1">
                    <span>{item.type}</span>
                    <span class="text-brand-accent font-medium">{item.tour}</span>
                  </div>
                </div>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ Section -->
  {formattedFaqs.length > 0 && (
    <section class="py-24 bg-white dark:bg-slate-900 px-4">
      <div class="max-w-4xl mx-auto">
        <FadeIn client:visible delay={0.1}>
          <div class="text-center mb-16">
            <span class="text-xs uppercase tracking-widest text-brand-accent font-bold">Merak Edilenler</span>
            <h2 class="text-3xl md:text-5xl text-brand-primary dark:text-white font-serif font-bold mt-2">Sıkça Sorulan Sorular</h2>
          </div>
        </FadeIn>
        <Accordion client:visible faqs={formattedFaqs} />
      </div>
    </section>
  )}
</Layout>
