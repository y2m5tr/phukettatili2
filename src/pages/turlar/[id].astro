---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Accordion from '../../components/ui/Accordion';

export const prerender = true;

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({
    params: { id: tour.id },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { Content } = await render(tour);
---

<Layout title={tour.data.title} description={tour.data.excerpt} image={`/assets/${tour.data.image}`}>
  <!-- Hero Section for Tour -->
  <section class="relative h-[60vh] min-h-[400px] flex items-end pb-12">
    <div class="absolute inset-0 z-0">
      <img
        src={`/assets/${tour.data.image}`}
        alt={tour.data.title}
        class="w-full h-full object-cover animate-ken-burns"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0a0f1a] via-[#0a0f1a]/50 to-transparent z-10"></div>
    </div>

    <div class="relative z-20 max-w-6xl mx-auto px-4 w-full">
      <span class="inline-block bg-brand-accent text-white px-3 py-1 rounded-full text-sm font-bold tracking-wide uppercase mb-4 shadow-lg">
        {tour.data.category_label || tour.data.category}
      </span>
      <h1 class="text-4xl md:text-6xl text-white mb-4 drop-shadow-md">
        {tour.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-6 text-slate-200">
        {tour.data.duration && (
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>{tour.data.duration}</span>
          </div>
        )}
        {tour.data.price_thb && tour.data.price_thb > 0 ? (
          <div class="flex items-center gap-2 font-bold text-xl text-white">
            <span>{tour.data.price_thb.toLocaleString()} THB</span>
          </div>
        ) : (
          <div class="flex items-center gap-2 font-semibold text-base text-brand-accent bg-white/10 backdrop-blur px-3 py-1 rounded-full border border-white/20">
            <span>Fiyat Teklifi Alın</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 bg-slate-50 dark:bg-[#0a0f1a]">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-2 prose prose-lg prose-slate dark:prose-invert prose-headings:font-serif prose-headings:text-brand-primary dark:prose-headings:text-white prose-a:text-brand-accent hover:prose-a:text-brand-primary max-w-none">
        <h2 class="text-3xl border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">Tur Hakkında</h2>
        <Content />

        {tour.data.program && tour.data.program.length > 0 && (
          <div class="mt-16">
            <h3 class="text-3xl border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">Tur Programı (Itinerary)</h3>
            <div class="relative border-l-2 border-brand-accent ml-4 space-y-8 pb-4">
              {tour.data.program.map((item) => {
                const match = item.match(/^(\d{1,2}:\d{2})\s*[-–]\s*(.+)$/);
                const time = match ? match[1] : '';
                const desc = match ? match[2] : item;
                
                return (
                  <div class="relative pl-8">
                    <span class="absolute -left-[11px] top-1 w-5 h-5 rounded-full bg-brand-accent border-4 border-slate-50 dark:border-[#0a0f1a]"></span>
                    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
                      {time && <span class="inline-block bg-brand-accent/10 text-brand-accent font-bold px-3 py-1 rounded-full text-sm mb-3">{time.trim()}</span>}
                      <p class="text-slate-600 dark:text-slate-300 m-0 leading-relaxed">{desc.trim()}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {tour.data.gallery && tour.data.gallery.length > 0 && (
          <div class="mt-16">
            <h3 class="text-3xl border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">Galeri</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
              {tour.data.gallery.map((img) => (
                <img 
                  src={`/assets/${img}`} 
                  alt="Tur Fotoğrafı" 
                  class="w-full h-48 md:h-56 object-cover rounded-2xl shadow-sm hover:scale-105 transition-transform cursor-pointer" 
                />
              ))}
            </div>
          </div>
        )}

        {tour.data.faq && tour.data.faq.length > 0 && (
          <div class="mt-16">
            <h3 class="text-3xl border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">Sıkça Sorulan Sorular</h3>
            <Accordion client:load faqs={tour.data.faq} />
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="sticky top-28 bg-white dark:bg-slate-800 rounded-2xl shadow-xl p-8 border border-slate-100 dark:border-slate-700">
          <h3 class="font-serif text-2xl font-bold text-brand-primary dark:text-white mb-6">Rezervasyon</h3>
          <p class="text-slate-600 dark:text-slate-400 mb-8">Bu tur için uygunluğu kontrol etmek ve hemen rezervasyon yapmak için bize WhatsApp'tan ulaşın.</p>
          
          <a 
            href={`https://wa.me/66828950665?text=${encodeURIComponent(`Merhaba, ${tour.data.title} turu hakkında bilgi almak istiyorum.`)}`}
            target="_blank"
            class="flex items-center justify-center gap-2 w-full bg-[#25D366] hover:bg-[#128C7E] text-white px-6 py-4 rounded-xl font-bold transition-colors shadow-lg shadow-green-500/30"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp'tan Sor
          </a>

          {(tour.data.included && tour.data.included.length > 0) || (tour.data.excluded && tour.data.excluded.length > 0) ? (
            <div class="mt-8 border-t border-slate-100 dark:border-slate-700 pt-6">
              {tour.data.included && tour.data.included.length > 0 && (
                <div class="mb-6">
                  <h4 class="font-bold mb-3 text-slate-800 dark:text-slate-200 flex items-center gap-2">
                    <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Dahil Olanlar
                  </h4>
                  <ul class="text-sm text-slate-600 dark:text-slate-400 space-y-2">
                    {tour.data.included.map(item => <li>• {item}</li>)}
                  </ul>
                </div>
              )}
              {tour.data.excluded && tour.data.excluded.length > 0 && (
                <div>
                  <h4 class="font-bold mb-3 text-slate-800 dark:text-slate-200 flex items-center gap-2">
                    <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    Dahil Olmayanlar
                  </h4>
                  <ul class="text-sm text-slate-600 dark:text-slate-400 space-y-2">
                    {tour.data.excluded.map(item => <li>• {item}</li>)}
                  </ul>
                </div>
              )}
            </div>
          ) : null}
        </div>
      </div>
    </div>
  </section>
</Layout>
